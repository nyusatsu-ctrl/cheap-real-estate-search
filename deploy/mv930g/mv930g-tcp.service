[Unit]
Description=MV930G-G JT/T 808 receive-only TCP gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/mv930g
EnvironmentFile=/etc/mv930g/mv930g.env
ExecStart=/usr/bin/node /opt/mv930g/server/mv930g/tcp-server.mjs
Restart=on-failure
RestartSec=5
StateDirectory=mv930g
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/mv930g
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
